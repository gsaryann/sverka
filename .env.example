# =====================================================================
# Настройки подключения к Yandex AI Studio / Yandex Cloud
# (Требуются только при включении режима ИИ-арбитража с Алисой)
# =====================================================================

# 1. API-ключ сервисного аккаунта Yandex Cloud или ключ Yandex AI Studio:
YANDEX_API_KEY=your_yandex_api_key_here

# 2. Идентификатор каталога в Yandex Cloud (Folder ID):
YANDEX_FOLDER_ID=your_folder_id_here

# 3. Идентификатор модели (по умолчанию Alice AI LLM Flash):
YANDEX_MODEL=aliceai-llm-flash/latest
