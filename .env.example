# =====================================================================
# Конфигурация окружения платформы «СверкаСмет» (.env.example)
# Скопируйте этот файл в .env и укажите актуальные значения для вашей среды.
# =====================================================================

# 1. Режим окружения (development / production)
# В production ОБЯЗАТЕЛЬНО задавать надежные SECRET_KEY и DB_PASS!
ENV=development

# 2. Секретный ключ для подписи сессий Flask (Cookie session signature)
# Для генерации надежного ключа: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-32-byte-hex-secret-in-production

# 3. База данных PostgreSQL 17
DB_USER=postgres
DB_PASS=P@ssw0rd
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sverka_db

# 4. Демо-пользователь (для локального тестирования)
# В production устанавливайте SEED_DEMO_USER=0
SEED_DEMO_USER=1
DEMO_USER_PASSWORD=P@ssw0rd

# 5. Нейросетевой арбитр Yandex AI Studio (Алиса / aliceai-llm-flash)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm-flash/latest

# 6. Нейросетевой арбитр GigaChat (Сбер)
GIGACHAT_AUTH_KEY=
CLIENT_ID=
SCOPE=GIGACHAT_API_PERS
